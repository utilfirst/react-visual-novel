{
  "name": "react-visual-novel-demo",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "pnpm run generate && next build --webpack",
    "dev": "pnpm run generate && pnpm run '/^dev:[^:]+$/'",
    "dev:css": "pnpm run generate:css --watch",
    "dev:next": "next dev --webpack",
    "generate": "pnpm run --sequential '/^generate:[^:]+$/'",
    "generate:css": "tailwindcss -c tailwind.config.ts -i index.css -o __generated__/index.css --minify",
    "generate:next": "next typegen",
    "start": "next start"
  },
  "dependencies": {
    "howler": "2.2.3",
    "next": "16.3.6",
    "next-query-params": "5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-visual-novel": "workspace:*",
    "use-query-params": "2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.7",
    "@types/howler": "2.2.13",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.1",
    "daisyui": "2.52.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tailwindcss-scrims": "1.0.0"
  }
}
