{
  "name": "react-visual-novel",
  "version": "0.2.2",
  "description": "React library for building web-based visual novels",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilfirst/react-visual-novel.git",
    "directory": "packages/react-visual-novel"
  },
  "license": "MIT",
  "author": "Ayan Yenbekbay <ayan@utility-first.co> (https://utility-first.co)",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./dist/index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/index.d.ts": "./dist/index.d.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && pnpm run generate-css --minify",
    "dev": "pnpm run '/^dev:[^:]+$/'",
    "dev:css": "pnpm run generate-css --watch",
    "dev:ts": "tsdown --watch --no-clean",
    "generate-css": "tailwindcss -i index.css -o dist/index.css",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "async-preloader": "7.0.0",
    "framer-motion": "13.4.4",
    "mdast-util-from-markdown": "1.2.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/howler": "2.2.13",
    "@types/mdast": "3.0.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "howler": "2.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0"
  },
  "peerDependencies": {
    "howler": "^2.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
