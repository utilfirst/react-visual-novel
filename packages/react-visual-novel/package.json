{
  "name": "react-visual-novel",
  "version": "0.2.2",
  "description": "React library for building web-based visual novels",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilfirst/react-visual-novel.git",
    "directory": "packages/react-visual-novel"
  },
  "license": "MIT",
  "author": "Ayan Yenbekbay <ayan@utility-first.co> (https://utility-first.co)",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./dist/index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/index.d.ts": "./dist/index.d.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && pnpm run generate-css --minify",
    "dev": "pnpm run '/^dev:[^:]+$/'",
    "dev:css": "pnpm run generate-css --watch",
    "dev:ts": "tsdown --watch --no-clean",
    "generate-css": "tailwindcss -c tailwind.config.ts -i index.css -o dist/index.css",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@radix-ui/react-popover": "1.0.2",
    "@radix-ui/react-use-rect": "1.0.0",
    "@react-hookz/web": "16.0.0",
    "@supercharge/promise-pool": "2.3.2",
    "async-preloader": "7.0.0",
    "framer-motion": "7.6.1",
    "intrinsic-scale": "3.0.4",
    "mdast-util-from-markdown": "1.2.0",
    "micro-observables": "1.7.2",
    "moize": "6.1.3",
    "phosphor-react": "1.4.1",
    "react-is": "18.2.0",
    "string-dedent": "3.0.2",
    "tailwind-merge": "1.6.2",
    "use-event-callback": "0.1.0",
    "use-long-press": "3.3.0"
  },
  "devDependencies": {
    "@types/howler": "2.2.13",
    "@types/intrinsic-scale": "3.0.3",
    "@types/mdast": "3.0.15",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-is": "18.3.1",
    "csstype": "3.2.3",
    "howler": "2.2.3",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-scrims": "1.0.0",
    "tsdown": "0.23.0",
    "use-query-params": "2.1.1"
  },
  "peerDependencies": {
    "howler": "^2.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "use-query-params": "^2.1.0"
  }
}
