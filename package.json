{
  "name": "react-visual-novel-root",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilfirst/react-visual-novel.git"
  },
  "author": "Ayan Yenbekbay <ayan@utility-first.co>",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter react-visual-novel run build && pnpm --filter react-visual-novel-demo run build",
    "dev": "pnpm run generate && pnpm --recursive --parallel run dev",
    "fix": "pnpm run generate && pnpm run --sequential '/^fix:[^:]+$/'",
    "fix:oxlint": "pnpm run lint:oxlint --fix",
    "fix:prettier": "pnpm run lint:prettier --write",
    "generate": "pnpm --filter react-visual-novel run build && pnpm --filter react-visual-novel-demo run generate",
    "lint": "pnpm run generate && pnpm run '/^lint:[^:]+$/'",
    "lint:declarations": "tsc --ignoreConfig --noEmit --strict --module NodeNext --target ES2022 --pretty false packages/react-visual-novel/dist/index.d.ts",
    "lint:oxlint": "oxlint .",
    "lint:prettier": "prettier --check .",
    "lint:publint": "pnpm --filter react-visual-novel exec publint",
    "release-check-tag": "node scripts/check-release-tag.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@utilfirst/eslint-plugin": "0.4.8",
    "@utilfirst/prettier-plugin": "0.1.2",
    "browserslist-config-baseline": "0.5.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.20.2",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "publint": "0.3.24",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.21.0 <12"
  }
}
